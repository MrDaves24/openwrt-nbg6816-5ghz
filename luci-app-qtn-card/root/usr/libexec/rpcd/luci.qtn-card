#!/bin/sh
# The 5 GHz page's backend: qtn-card get and qtn-card set as ubus calls. A failure comes back as
# {"error": what qtn-card said}.

. /usr/share/libubox/jshn.sh

fail() {
	json_init
	json_add_string error "$1"
	json_dump
	exit 0
}

case "$1" in
list)
	echo '{"get":{},"set":{"ssid":"str","key":"str","channel":"str","radio":"str"}}'
	;;
call)
	case "$2" in
	get)
		out=$(qtn-card get 2>&1) || fail "$out"
		json_init
		while IFS= read -r l; do
			json_add_string "${l%%=*}" "${l#*=}"
		done <<END
$out
END
		json_dump
		;;
	set)
		read -r input
		# jsonfilter from stdin: json_load would put the key in a command line
		out=$(for f in ssid key channel radio; do
			v=$(printf %s "$input" | jsonfilter -e "@.$f")
			[ -z "$v" ] || printf '%s=%s\n' "$f" "$v"
		done | qtn-card set 2>&1) || fail "$out"
		echo '{}'
		;;
	esac
	;;
esac
